layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }

    tab name="1_H" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio"
            pane cwd="/Users/mattia.picchio"
        }
    }

    tab name="2_MAIN" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio/reps"
            pane split_direction="horizontal" {
                pane cwd="/Users/mattia.picchio/reps"
                pane cwd="/Users/mattia.picchio/reps"
            }
        }
    }

    tab name="3_WT1" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio/reps/appwt"
            pane split_direction="horizontal" {
                pane cwd="/Users/mattia.picchio/reps/appwt"
                pane cwd="/Users/mattia.picchio/reps/appwt"
            }
        }
    }

    tab name="4_WT2" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio/reps/appwt"
            pane split_direction="horizontal" {
                pane cwd="/Users/mattia.picchio/reps/appwt"
                pane cwd="/Users/mattia.picchio/reps/appwt"
            }
        }
    }

    tab name="5_WT3" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio/reps/appwt"
            pane split_direction="horizontal" {
                pane cwd="/Users/mattia.picchio/reps/appwt"
                pane cwd="/Users/mattia.picchio/reps/appwt"
            }
        }
    }

    tab name="6_Y" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio"
            pane cwd="/Users/mattia.picchio"
        }
    }

    tab name="7_CHEATS" {
        pane split_direction="vertical" {
            pane cwd="/Users/mattia.picchio/cheatsheets"
            pane cwd="/Users/mattia.picchio/cheatsheets"
        }
    }

    tab name="8_BTOP" {
        pane cwd="/Users/mattia.picchio" {
            command "btop"
        }
    }
}
