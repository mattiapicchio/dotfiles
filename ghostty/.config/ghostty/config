# theme = "Monokai Pro Octagon"
# theme = "jubi"
# theme = "Violet Dark"
#theme = Ultra Violent
theme = dark:Bluloco Dark,light:Catppuccin Latte
# theme = dark:Catppuccin Macchiato,light:Catppuccin Latte
# theme = dark:Monokai Pro Octagon,light:Box
# theme = Box
font-size = 14
font-family = Victor Mono
# font-family = JetBrainsMono Nerd Font
# font-family = Monospace Neon
mouse-hide-while-typing = false
window-decoration = true
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
background-blur-radius = 40
background-opacity = 0.99

#macos
macos-titlebar-style = hidden
# macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-option-as-alt = true
macos-non-native-fullscreen = true

# Clipboard
copy-on-select = clipboard
clipboard-paste-protection = false

# keymaps
keybind = opt+2=text:@
keybind = shift+enter=text:\x1b\r
keybind = opt+4=text:$
keybind = escape=text:\x1b
keybind = caps_lock=text:\x1b
keybind = opt+8=text:[
keybind = opt+9=text:]
keybind = shift+opt+8=text:{
keybind = shift+opt+9=text:}
keybind = opt+7=text:\x7c
keybind = opt+right_bracket=text:~


